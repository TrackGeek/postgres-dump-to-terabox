{
  "name": "postgres-dump-to-terabox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "once": "bun run src/index.ts --once",
    "login": "bun run scripts/login.ts",
    "types": "tsc --noEmit",
    "lint": "biome lint",
