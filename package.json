    "format": "biome format",
    "format:fix": "biome format --write"
  },
  "dependencies": {
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "terabox-upload-tool": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
